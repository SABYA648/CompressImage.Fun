---
interface Item {
  label: string;
  href?: string;
}
const { items } = Astro.props as { items: Item[] };
---

<nav class="breadcrumbs shell" aria-label="Breadcrumb">
  <ol>
    {
      items.map((item, index) => (
        <li>
          {item.href ? (
            <a
              href={item.href}
              data-umami-event="Breadcrumb Click"
              data-umami-event-target={item.label}
            >
              {item.label}
            </a>
          ) : (
            <span aria-current="page">{item.label}</span>
          )}
          {index < items.length - 1 && <span aria-hidden="true">/</span>}
        </li>
      ))
    }
  </ol>
</nav>
