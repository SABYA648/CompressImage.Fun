---
import SiteLayout from '../layouts/SiteLayout.astro';
---

<SiteLayout
  title="Page not found | compressimage.fun"
  description="The requested page could not be found."
  canonicalPath="/404"
>
  <section class="hero">
    <div class="shell">
      <div class="eyebrow">404</div><h1>That page got compressed out of existence</h1><p
        class="lead"
      >
        The image tools are still right where they should be.
      </p><p><a class="primary-button" href="/tools" data-umami-event="404 Browse Tools Click">Browse all tools</a></p>
    </div>
  </section>
</SiteLayout>
