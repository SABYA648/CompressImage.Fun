---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import RelatedTools from '../../components/RelatedTools.astro';
import ToolEmbed from '../../components/ToolEmbed.astro';
import { guides } from '../../data/guides';
import { toolById } from '../../data/tools';

export function getStaticPaths() {
  return guides.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}
const { guide } = Astro.props;
const primaryTool =
  guide.relatedTools.map((id: string) => toolById.get(id)).find(Boolean) ??
  toolById.get('image-compressor')!;
---

<SiteLayout
  title={`${guide.title} | compressimage.fun`}
  description={guide.description}
  canonicalPath={`/guides/${guide.slug}`}
  pageType="article"
  h1={guide.title}
  updatedAt="2026-08-23"
>
  <Breadcrumbs items={[{ label: 'Guides', href: '/guides' }, { label: guide.title }]} />
  <header class="hero compact">
    <div class="shell">
      <div class="eyebrow">{guide.readMinutes} minute guide · Updated August 23, 2026</div><h1>
        {guide.title}
      </h1><p class="lead">
        {guide.description}
      </p>
    </div>
  </header>
  <article class="article shell">
    <div class="article-body">
      <p class="article-summary">{guide.summary}</p>
    </div>
    <section class="guide-tool" aria-labelledby="guide-tool-title">
      <div class="guide-tool-heading">
        <div>
          <div class="eyebrow">Do it here</div>
          <h2 id="guide-tool-title">{primaryTool.h1}</h2>
        </div>
        <p>{primaryTool.lead}</p>
      </div>
      <ToolEmbed tool={primaryTool} />
    </section>
    <div class="article-body">
      {
        guide.sections.map((section) => (
          <section>
            <h2>{section.heading}</h2>
            {section.paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {section.bullets && (
              <ul>
                {section.bullets.map((bullet) => (
                  <li>{bullet}</li>
                ))}
              </ul>
            )}
          </section>
        ))
      }
    </div>
    <!-- Author card: sabya.pm. Replace SOURCE_SLUG only. -->
    <aside class="sabyacard" data-sabyacard="blog" aria-label="About the author">
      <a
        class="sabyacard__portrait"
        href="https://sabya.pm/?utm_source=compressimage&utm_medium=author_card&utm_campaign=eeat&utm_content=blog"
        target="_blank"
        rel="noopener"
        tabindex="-1"
        aria-hidden="true"
      >
        <img
          src="https://sabya.pm/embed/author-card/avatar-96.webp"
          srcset="https://sabya.pm/embed/author-card/avatar-96.webp 1x, https://sabya.pm/embed/author-card/avatar-192.webp 2x"
          width="96"
          height="96"
          alt=""
          loading="lazy"
          decoding="async"
        />
      </a>
      <div class="sabyacard__body">
        <p class="sabyacard__heading">
          <span class="sabyacard__eyebrow">Written by</span><a
            class="sabyacard__name"
            href="https://sabya.pm/?utm_source=compressimage&utm_medium=author_card&utm_campaign=eeat&utm_content=blog"
            target="_blank"
            rel="author me noopener">Sabyasachi Mishra</a
          >
        </p>
        <p class="sabyacard__role">AI Product Manager &amp; Systems Builder</p>
        <p class="sabyacard__bio">
          Builds AI products that hold up in production, and independently runs Shiproom,
          teleprompter.wtf, and compressimage.fun.
        </p>
        <p class="sabyacard__links">
          <a
            class="sabyacard__link"
            href="https://sabya.pm/?utm_source=compressimage&utm_medium=author_card&utm_campaign=eeat&utm_content=blog"
            target="_blank"
            rel="author me noopener">sabya.pm</a
          >
          <span class="sabyacard__icons">
            <a
              class="sabyacard__icon"
              href="https://x.com/SabyaShips"
              target="_blank"
              rel="me noopener"
              aria-label="Sabyasachi Mishra on X"
              ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                ><path
                  d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117Z"
                ></path></svg
              ></a
            >
            <a
              class="sabyacard__icon"
              href="https://www.linkedin.com/in/sabya007/"
              target="_blank"
              rel="me noopener"
              aria-label="Sabyasachi Mishra on LinkedIn"
              ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                ><path
                  d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
                ></path></svg
              ></a
            >
            <a
              class="sabyacard__icon"
              href="https://github.com/SABYA648"
              target="_blank"
              rel="me noopener"
              aria-label="Sabyasachi Mishra on GitHub"
              ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                ><path
                  d="M12 .3a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58l-.01-2.04c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.08 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.64 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3Z"
                ></path></svg
              ></a
            >
          </span>
        </p>
      </div>
      <img
        class="sabyacard__beacon"
        src="https://sabya.pm/api/author-card/view?s=compressimage&p=blog"
        alt=""
        width="1"
        height="1"
        aria-hidden="true"
        decoding="async"
        referrerpolicy="no-referrer"
      />
    </aside>
  </article>
  <RelatedTools ids={guide.relatedTools} />
</SiteLayout>
