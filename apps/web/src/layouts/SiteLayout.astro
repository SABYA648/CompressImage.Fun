---
import '../styles/global.css';
import { tools, toolPath } from '../data/tools';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  pageType?: 'tool' | 'article' | 'page';
  h1?: string;
  breadcrumbs?: Array<{ name: string; path: string }>;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  pageType = 'page',
  h1,
  breadcrumbs,
} = Astro.props;
const canonical = new URL(canonicalPath || '/', 'https://compressimage.fun').toString();
const verificationGoogle = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const verificationBing = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const gaId = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '').trim();
const safeGaId = /^G-[A-Z0-9]+$/i.test(gaId) ? gaId.toUpperCase() : undefined;
const umamiId = String(import.meta.env.PUBLIC_UMAMI_WEBSITE_ID ?? '').trim();
const umamiSrc = String(
  import.meta.env.PUBLIC_UMAMI_SCRIPT_URL ?? 'https://analytics.sabya.pm/script.js',
).trim();
const safeUmamiId = /^[a-z0-9-]{8,}$/i.test(umamiId) ? umamiId : undefined;
const safeUmamiSrc =
  safeUmamiId && /^https:\/\/analytics\.sabya\.pm\/script\.js$/.test(umamiSrc)
    ? umamiSrc
    : undefined;
const popular = tools.filter((tool) => tool.popular).slice(0, 5);
const organization = {
  '@type': 'Organization',
  '@id': 'https://compressimage.fun/#organization',
  name: 'compressimage.fun',
  url: 'https://compressimage.fun/',
};
const website = {
  '@type': 'WebSite',
  '@id': 'https://compressimage.fun/#website',
  url: 'https://compressimage.fun/',
  name: 'compressimage.fun',
  description:
    'Compress an image to the size you actually need, with quality tradeoffs visible. Temporary server jobs plus browser-only Base64, PDF, and color tools.',
  publisher: { '@id': 'https://compressimage.fun/#organization' },
};
const breadcrumbSchema = breadcrumbs?.length
  ? {
      '@type': 'BreadcrumbList',
      itemListElement: breadcrumbs.map((item, index) => ({
        '@type': 'ListItem',
        position: index + 1,
        name: item.name,
        item: new URL(item.path, 'https://compressimage.fun').toString(),
      })),
    }
  : undefined;
const schema =
  pageType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          organization,
          website,
          {
            '@type': 'Article',
            headline: h1 ?? title,
            description,
            mainEntityOfPage: canonical,
            publisher: { '@id': 'https://compressimage.fun/#organization' },
          },
          ...(breadcrumbSchema ? [breadcrumbSchema] : []),
        ],
      }
    : {
        '@context': 'https://schema.org',
        '@graph': [
          organization,
          website,
          ...(pageType === 'tool'
            ? [
                {
                  '@type': 'WebApplication',
                  name: h1 ?? title,
                  url: canonical,
                  applicationCategory: 'MultimediaApplication',
                  operatingSystem: 'Any',
                  browserRequirements: 'Requires a modern web browser',
                  isAccessibleForFree: true,
                  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
                  description,
                  ...(canonical === 'https://compressimage.fun/'
                    ? {
                        featureList: [
                          'Exact KB and MB compression with quality-first search',
                          'Batch compression without signup or product watermark',
                          'Temporary same-origin server processing with Delete now',
                          'Browser-only Base64, Image to PDF, and color picker tools',
                        ],
                      }
                    : {}),
                },
              ]
            : []),
          ...(breadcrumbSchema ? [breadcrumbSchema] : []),
        ],
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fffdf8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- Declaring icons stops the browser requesting /favicon.ico and logging a 404. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content="compressimage.fun" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://compressimage.fun/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="compressimage.fun: compress to the size you actually need"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://compressimage.fun/og.png" />
    {verificationGoogle && <meta name="google-site-verification" content={verificationGoogle} />}
    {verificationBing && <meta name="msvalidate.01" content={verificationBing} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    {
      safeGaId && (
        <>
          <script async src={`https://www.googletagmanager.com/gtag/js?id=${safeGaId}`} />
          <script is:inline define:vars={{ gaId: safeGaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId, { anonymize_ip: true, allow_google_signals: false });
          </script>
        </>
      )
    }
    {
      safeUmamiId && safeUmamiSrc && (
        <script is:inline define:vars={{ umamiSrc: safeUmamiSrc, umamiId: safeUmamiId }}>
          const script = document.createElement('script');
          script.defer = true;
          script.src = umamiSrc;
          script.dataset.websiteId = umamiId;
          document.head.appendChild(script);
        </script>
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#main" data-umami-event="Skip to Main Content">Skip to main content</a>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href="/" aria-label="compressimage.fun home" data-umami-event="Header Brand Click">
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>compressimage<span>.fun</span></span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/tools" data-umami-event="Nav Click: All Tools">All tools</a>
          <a href="/compress-image-to-size" data-umami-event="Nav Click: Exact Size">Exact size</a>
          <a href="/how-processing-works" data-umami-event="Nav Click: How processing works">How it works</a>
          <a href="/guides" data-umami-event="Nav Click: Guides">Guides</a>
          <a href="/privacy" data-umami-event="Nav Click: Privacy">Privacy</a>
        </nav>
      </div>
    </header>
    <!-- tabindex allows the skip link to move focus here, not just scroll the page. -->
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand footer-brand" href="/" data-umami-event="Footer Brand Click">compressimage<span>.fun</span></a>
          <p>Compress to the size you actually need, with the tradeoffs visible.</p>
          <p class="muted">No account, no watermark, no artificial daily limit.</p>
        </div>
        <div>
          <h2>Popular tools</h2>
          <ul>
            {
              popular.map((tool) => (
                <li>
                  <a href={toolPath(tool)} data-umami-event="Footer Popular Tool Click" data-umami-event-tool={tool.id}>{tool.h1}</a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2>Project</h2>
          <ul>
            <li><a href="/privacy" data-umami-event="Footer Link Click: Privacy">Privacy</a></li>
            <li><a href="/how-processing-works" data-umami-event="Footer Link Click: How processing works">How processing works</a></li>
            <li><a href="/compression-tests" data-umami-event="Footer Link Click: Compression tests">Compression tests</a></li>
            <li><a href="/guides" data-umami-event="Footer Link Click: Guides">Guides</a></li>
            <li><a href="/tools" data-umami-event="Footer Link Click: Tools">Tool index</a></li>
            <li><a href="/llms.txt" data-umami-event="Footer Link Click: llms.txt">llms.txt</a></li>
          </ul>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} compressimage.fun</span>
        <span>Files auto-delete within four hours.</span>
      </div>
    </footer>
  </body>
</html>
