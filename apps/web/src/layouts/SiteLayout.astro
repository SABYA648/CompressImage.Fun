---
import '../styles/global.css';
import { tools, toolPath } from '../data/tools';

interface Props {
  title: string;
  description: string;
  canonicalPath?: string;
  pageType?: 'tool' | 'article' | 'page';
  h1?: string;
  noindex?: boolean;
  updatedAt?: string;
}

const {
  title,
  description,
  canonicalPath = Astro.url.pathname,
  pageType = 'page',
  h1,
  noindex = false,
  updatedAt,
} = Astro.props;
const canonical = new URL(canonicalPath || '/', 'https://compressimage.fun').toString();
const verificationGoogle = import.meta.env.PUBLIC_GOOGLE_SITE_VERIFICATION;
const verificationBing = import.meta.env.PUBLIC_BING_SITE_VERIFICATION;
const gaId = String(import.meta.env.PUBLIC_GA_MEASUREMENT_ID ?? '').trim();
const safeGaId = /^G-[A-Z0-9]+$/i.test(gaId) ? gaId.toUpperCase() : undefined;
const gaBootstrap = safeGaId
  ? `window.dataLayer=window.dataLayer||[];window.gtag=(...args)=>window.dataLayer.push(args);window.gtag('js',new Date());window.gtag('config',${JSON.stringify(safeGaId)},{anonymize_ip:true,allow_google_signals:false});`
  : undefined;
const popular = tools.filter((tool) => tool.popular).slice(0, 5);
const robots = noindex
  ? 'noindex, follow, noarchive'
  : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1';
const organization = {
  '@type': 'Organization',
  '@id': 'https://compressimage.fun/#organization',
  name: 'compressimage.fun',
  url: 'https://compressimage.fun/',
};
const pageGraph: Record<string, unknown>[] = [
  {
    '@type': 'WebSite',
    '@id': 'https://compressimage.fun/#website',
    url: 'https://compressimage.fun/',
    name: 'compressimage.fun',
    description:
      'Free image compression, exact-size targeting, and conversion tools without signup or watermarks.',
  },
  organization,
];
if (pageType === 'tool') {
  pageGraph.push({
    '@type': 'WebApplication',
    name: h1 ?? title,
    url: canonical,
    applicationCategory: 'MultimediaApplication',
    operatingSystem: 'All',
    browserRequirements: 'Requires a modern web browser',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
    description,
    featureList:
      'Exact KB/MB targeting, quality-first optimization, batch processing, zero watermark, 4-hour automatic file deletion',
  });
  if (canonical !== 'https://compressimage.fun/') {
    pageGraph.push({
      '@type': 'BreadcrumbList',
      itemListElement: [
        {
          '@type': 'ListItem',
          position: 1,
          name: 'Home',
          item: 'https://compressimage.fun/',
        },
        {
          '@type': 'ListItem',
          position: 2,
          name: 'Tools',
          item: 'https://compressimage.fun/tools',
        },
        { '@type': 'ListItem', position: 3, name: h1 ?? title, item: canonical },
      ],
    });
  }
}
const schema =
  pageType === 'article'
    ? {
        '@context': 'https://schema.org',
        '@graph': [
          organization,
          {
            '@type': 'Article',
            headline: h1 ?? title,
            description,
            mainEntityOfPage: canonical,
            url: canonical,
            inLanguage: 'en-US',
            publisher: { '@id': 'https://compressimage.fun/#organization' },
            author: { '@id': 'https://sabya.pm/#person' },
            ...(updatedAt ? { dateModified: updatedAt } : {}),
          },
          {
            '@type': 'BreadcrumbList',
            itemListElement: [
              {
                '@type': 'ListItem',
                position: 1,
                name: 'Home',
                item: 'https://compressimage.fun/',
              },
              {
                '@type': 'ListItem',
                position: 2,
                name: 'Guides',
                item: 'https://compressimage.fun/guides',
              },
              { '@type': 'ListItem', position: 3, name: h1 ?? title, item: canonical },
            ],
          },
        ],
      }
    : {
        '@context': 'https://schema.org',
        '@graph': pageGraph,
      };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#fffdf8" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />
    <meta name="author" content="compressimage.fun" />
    <link rel="canonical" href={canonical} />
    <link rel="alternate" type="text/plain" href="https://compressimage.fun/llms.txt" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="compressimage.fun image guides"
      href="https://compressimage.fun/guides/feed.xml"
    />
    <!-- Declaring icons stops the browser requesting /favicon.ico and logging a 404. -->
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="stylesheet" href="https://sabya.pm/embed/author-card/author-card.css" />
    <meta property="og:type" content={pageType === 'article' ? 'article' : 'website'} />
    <meta property="og:site_name" content="compressimage.fun" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://compressimage.fun/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta
      property="og:image:alt"
      content="compressimage.fun: Compress images without the guesswork"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://compressimage.fun/og.png" />
    {verificationGoogle && <meta name="google-site-verification" content={verificationGoogle} />}
    {verificationBing && <meta name="msvalidate.01" content={verificationBing} />}
    <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        '@context': 'https://schema.org',
        '@type': 'Person',
        '@id': 'https://sabya.pm/#person',
        name: 'Sabyasachi Mishra',
        url: 'https://sabya.pm',
        image: 'https://sabya.pm/embed/author-card/avatar-192.webp',
        jobTitle: 'AI Product Manager',
        description:
          'AI product manager who builds production AI systems and independently operates Shiproom, teleprompter.wtf, and compressimage.fun.',
        knowsAbout: [
          'AI product management',
          'AI systems',
          'autonomous agents',
          'product strategy',
        ],
        sameAs: [
          'https://x.com/SabyaShips',
          'https://www.linkedin.com/in/sabya007/',
          'https://github.com/SABYA648',
          'https://medium.com/@sabyasachimishra648',
        ],
      })}
    />
    {
      safeGaId && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${safeGaId}`} />
          <script is:inline set:html={gaBootstrap} />
        </>
      )
    }
    <script
      is:inline
      defer
      src="https://analytics.sabya.pm/script.js"
      data-website-id="81d738e7-a725-4c3c-aac3-c6fde9c735ad"></script>
  </head>
  <body data-page-type={pageType}>
    <a class="skip-link" href="#main" data-umami-event="Skip to Main Content"
      >Skip to main content</a
    >
    <header class="site-header">
      <div class="shell header-inner">
        <a
          class="brand"
          href="/"
          aria-label="compressimage.fun home"
          data-umami-event="Header Brand Click"
        >
          <span class="brand-mark" aria-hidden="true"><span></span><span></span><span></span></span>
          <span>compressimage<span>.fun</span></span>
        </a>
        <nav aria-label="Main navigation">
          <a href="/tools" data-umami-event="Nav Click: All Tools">All tools</a>
          <a href="/compress-image-to-size" data-umami-event="Nav Click: Exact Size">Exact size</a>
          <a href="/guides" data-umami-event="Nav Click: Guides">Guides</a>
          <a href="/about" data-umami-event="Nav Click: About">About</a>
          <a href="/privacy" data-umami-event="Nav Click: Privacy">Privacy</a>
        </nav>
        <a class="header-cta" href="/" data-umami-event="Header Compress Click">Compress now</a>
      </div>
    </header>
    <!-- tabindex allows the skip link to move focus here, not just scroll the page. -->
    <main id="main" tabindex="-1"><slot /></main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <a class="brand footer-brand" href="/" data-umami-event="Footer Brand Click"
            >compressimage<span>.fun</span></a
          >
          <p>Drop an image. Get exactly what you need.</p>
          <p class="muted">No account, no watermark, no artificial daily limit.</p>
        </div>
        <div>
          <h2>Popular tools</h2>
          <ul>
            {
              popular.map((tool) => (
                <li>
                  <a
                    href={toolPath(tool)}
                    data-umami-event="Footer Popular Tool Click"
                    data-umami-event-tool={tool.id}
                  >
                    {tool.h1}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h2>Project</h2>
          <ul>
            <li><a href="/about" data-umami-event="Footer Link Click: About">About</a></li>
            <li>
              <a href="/methodology/compression" data-umami-event="Footer Link Click: Methodology"
                >Methodology</a
              >
            </li>
            <li><a href="/privacy" data-umami-event="Footer Link Click: Privacy">Privacy</a></li>
            <li><a href="/guides" data-umami-event="Footer Link Click: Guides">Guides</a></li>
            <li><a href="/tools" data-umami-event="Footer Link Click: Tools">Tool index</a></li>
            <li><a href="/llms.txt" data-umami-event="Footer Link Click: llms.txt">llms.txt</a></li>
          </ul>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>© {new Date().getFullYear()} compressimage.fun</span>
        <span>Files auto-delete within four hours.</span>
      </div>
      <!-- Author card: sabya.pm. Replace SOURCE_SLUG only. -->
      <aside class="sabyacard" data-sabyacard="footer" aria-label="Site author">
        <a
          class="sabyacard__portrait"
          href="https://sabya.pm/?utm_source=compressimage&utm_medium=author_card&utm_campaign=eeat&utm_content=footer"
          target="_blank"
          rel="noopener"
          tabindex="-1"
          aria-hidden="true"
        >
          <img
            src="https://sabya.pm/embed/author-card/avatar-96.webp"
            srcset="https://sabya.pm/embed/author-card/avatar-96.webp 1x, https://sabya.pm/embed/author-card/avatar-192.webp 2x"
            width="96"
            height="96"
            alt=""
            loading="lazy"
            decoding="async"
          />
        </a>
        <div class="sabyacard__body">
          <p class="sabyacard__heading">
            <span class="sabyacard__eyebrow">Built by</span><a
              class="sabyacard__name"
              href="https://sabya.pm/?utm_source=compressimage&utm_medium=author_card&utm_campaign=eeat&utm_content=footer"
              target="_blank"
              rel="author me noopener">Sabyasachi Mishra</a
            >
          </p>
          <p class="sabyacard__links">
            <span class="sabyacard__icons">
              <a
                class="sabyacard__icon"
                href="https://x.com/SabyaShips"
                target="_blank"
                rel="me noopener"
                aria-label="Sabyasachi Mishra on X"
                ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                  ><path
                    d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231Zm-1.161 17.52h1.833L7.084 4.126H5.117Z"
                  ></path></svg
                ></a
              >
              <a
                class="sabyacard__icon"
                href="https://www.linkedin.com/in/sabya007/"
                target="_blank"
                rel="me noopener"
                aria-label="Sabyasachi Mishra on LinkedIn"
                ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                  ><path
                    d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.42v1.56h.05c.47-.9 1.63-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13Zm1.78 13.02H3.55V9h3.57v11.45ZM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0Z"
                  ></path></svg
                ></a
              >
              <a
                class="sabyacard__icon"
                href="https://github.com/SABYA648"
                target="_blank"
                rel="me noopener"
                aria-label="Sabyasachi Mishra on GitHub"
                ><svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"
                  ><path
                    d="M12 .3a12 12 0 0 0-3.79 23.4c.6.1.82-.26.82-.58l-.01-2.04c-3.34.72-4.04-1.61-4.04-1.61-.55-1.39-1.34-1.76-1.34-1.76-1.08-.74.09-.73.09-.73 1.2.08 1.83 1.24 1.83 1.24 1.07 1.83 2.81 1.3 3.5 1 .1-.78.42-1.31.76-1.61-2.67-.3-5.47-1.33-5.47-5.93 0-1.31.47-2.38 1.24-3.22-.13-.3-.54-1.52.11-3.18 0 0 1-.32 3.3 1.23a11.5 11.5 0 0 1 6 0c2.29-1.55 3.3-1.23 3.3-1.23.64 1.66.24 2.88.12 3.18.77.84 1.23 1.91 1.23 3.22 0 4.61-2.8 5.63-5.48 5.92.43.37.81 1.1.81 2.22l-.01 3.29c0 .32.21.69.82.57A12 12 0 0 0 12 .3Z"
                  ></path></svg
                ></a
              >
            </span>
          </p>
        </div>
        <img
          class="sabyacard__beacon"
          src="https://sabya.pm/api/author-card/view?s=compressimage&p=footer"
          alt=""
          width="1"
          height="1"
          aria-hidden="true"
          decoding="async"
          referrerpolicy="no-referrer"
        />
      </aside>
    </footer>
  </body>
</html>
